{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.0.0",
  "id": "d90a9f1c-5eef-451f-8a97-d65527fd80ba",
  "packageName": "com.mitchelljfranklin.meetingtimer",
  "developer": {
    "name": "PLACEHOLDER — Your Company",
    "websiteUrl": "https://www.example.com",
    "privacyUrl": "https://www.example.com/privacy",
    "termsOfUseUrl": "https://www.example.com/terms"
  },
  "name": {
    "short": "Meeting Timer",
    "full": "Meeting Timer"
  },
  "description": {
    "short": "Multi-mode meeting timer (countdown, stopwatch, pomodoro)",
    "full": "A multi-timer app for Microsoft Teams meetings. Includes countdown timer with alert, stopwatch with lap tracking, and pomodoro timer with configurable work/break intervals. Runs in the meeting side panel so every participant can see the timer."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#6264A7",
  "configurableTabs": [
    {
      "configurationUrl": "{{BASE_URL}}/index.html",
      "canUpdateConfiguration": true,
      "scopes": ["groupchat"],
      "context": [
        "meetingSidePanel",
        "meetingChatTab",
        "meetingDetailsTab"
      ]
    }
  ],
  "staticTabs": [],
  "bots": [],
  "composeExtensions": [],
  "validDomains": ["{{BASE_URL_DOMAIN}}"]
}
